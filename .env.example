# NOTE: an MCP client (Claude Desktop / Claude Code) does NOT read this file. Put these three values in the
# "env" block of the server's entry in the client's config. This file is read only when you run the server
# yourself from a terminal. Check your setup with:  node dist/index.js --check

WP_BASE_URL=https://yoursite.com
WP_USERNAME=agent-user
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=3456
LOG_LEVEL=info

# Optional: the only directory app_deploy may zip and publish from (default: working directory).
# Set it to your project, e.g. /Users/you/dev/my-app
# WP_MCP_BUILD_ROOT=
